PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/bmi_db
JWT_ACCESS_TOKEN_SECRET=your_jwt_access_secret_here
JWT_REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_here

# Frontend Client URL
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Google SSO Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub SSO Credentials
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# LinkedIn SSO Credentials
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# Facebook SSO Credentials
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

